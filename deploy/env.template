# ==============================================================================
# PolymarketBot - Production Cloud Environment Configuration Template
# ==============================================================================
# Copy this template to .env or /etc/polymarketbot/polymarketbot.env:
#   cp deploy/env.template deploy/.env
#   chmod 600 deploy/.env
#
# IMPORTANT:
# - Never commit actual secrets or private keys to git.
# - Restrict file permissions: chmod 600 .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Polymarket CLOB API Authentication (L2 / L3 Access)
# ------------------------------------------------------------------------------
# API credentials obtained from https://polymarket.com or derived from wallet.
# Both POLY_* and POLYMARKET_* naming conventions are supported by the bot.
POLY_API_KEY=
POLY_SECRET=
POLY_PASSPHRASE=

# Aliases (mirrored for compatibility with all entrypoints)
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# ------------------------------------------------------------------------------
# 2. Polygon Wallet & Order Signer Credentials
# ------------------------------------------------------------------------------
# PRIVATE_KEY: 64-character hex private key of the authorized signer EOA.
# DO NOT include a 0x prefix if your key format is raw 64 hex characters (both work).
PRIVATE_KEY=
POLY_PRIVATE_KEY=

# PROXY_WALLET_ADDRESS: Address that holds your USDC.e collateral (the 'maker').
# - If trading with a raw EOA, set this to the signer's public Polygon address.
# - If using Polymarket web interface (Magic Link / Safe / Deposit Wallet),
#   set this to your Polymarket deposit address shown on polymarket.com.
PROXY_WALLET_ADDRESS=
POLY_ADDRESS=

# Signature Type:
#   0 = EOA (funds held directly by private key's address)
#   1 = Polymarket Proxy / Magic email wallet
#   2 = Gnosis Safe multisig proxy
#   3 = Polymarket Deposit Wallet (ERC-1271 Solady wrapped signature)
POLY_SIGNATURE_TYPE=0

# ------------------------------------------------------------------------------
# 3. Polymarket Relayer (Optional - for Gasless Safe/Deposit Wallet Operations)
# ------------------------------------------------------------------------------
# Generated in Polymarket Settings -> API Keys -> Relayer API Keys.
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=

# ------------------------------------------------------------------------------
# 4. RPC Nodes & Network Endpoints
# ------------------------------------------------------------------------------
# High-reliability Polygon PoS RPC endpoint (Alchemy, Infura, QuickNode, or dRPC).
# Recommended: Alchemy (e.g. https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY)
POLYGON_RPC_URL=https://polygon.drpc.org

# Optional Alchemy fallback URL (or ETH URL converted by bot to Polygon)
ETH_RPC_URL=

# Read-only fallback endpoints (comma-separated)
POLYGON_RPC_URLS=https://polygon.drpc.org,https://rpc.ankr.com/polygon

# CLOB REST and WebSocket endpoints
CLOB_API_URL=https://clob.polymarket.com
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# ------------------------------------------------------------------------------
# 5. Low-RAM VPS Resource & Memory Constraints (Critical for 1GB-4GB instances)
# ------------------------------------------------------------------------------
# DuckDB memory limit: restricts internal buffer pools to prevent kernel OOM killer
DUCKDB_MEMORY_LIMIT=1GB

# DuckDB query threads: set to 2 to minimize CPU contention and memory allocations
DUCKDB_THREADS=2

# Python runtime memory tuning
PYTHONUNBUFFERED=1
PYTHONOPTIMIZE=1
MALLOC_ARENA_MAX=2

# ------------------------------------------------------------------------------
# 6. Optional Cross-Venue & External Signals
# ------------------------------------------------------------------------------
# Kalshi cross-market basis monitoring (demo or prod)
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/opt/polymarketbot/secrets/kalshi_private_key.pem
KALSHI_ENV=demo

# NewsAPI key (collector optional feed)
NEWSAPI_KEY=

# ------------------------------------------------------------------------------
# 7. Cluster 5: Politics & Elections Exogenous Oracles (Free Tier Keys)
# ------------------------------------------------------------------------------
# FEC (Federal Election Commission) & Congress.gov API Key:
# Obtain free instant key via Google login at: https://api.data.gov/signup/
# Limits: 1,000 req/hr (demo fallback is 40 req/hr without key).
DATA_GOV_API_KEY=
FEC_API_KEY=

# Google Civic Information API Key:
# Enable in Google Cloud Console with free Google sign-in: https://console.cloud.google.com/
# Free quota: 25,000 queries/day (~1,041 req/hr) without billing.
GOOGLE_CIVIC_API_KEY=


# ------------------------------------------------------------------------------
# 8. Cluster 1: Crypto Fast-Expiry & Strike Markets Oracles
# ------------------------------------------------------------------------------
# Binance Public REST & WS (0-auth, 1200 req/min free):
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# Pyth Hermes Price Service (0-auth, free sub-second signed updates):
PYTH_HERMES_URL=https://hermes.pyth.network

# Coinbase Public API (0-auth, 10 req/s free):
COINBASE_API_URL=https://api.coinbase.com

# Alchemy Polygon Mainnet RPC (Chainlink on-chain reading & eth_getLogs):
# Google sign-in at: https://dashboard.alchemy.com/signup
# Free quota: 300 Million Compute Units (CU)/month, 330 CU/sec ceiling.
ALCHEMY_API_KEY=

# CoinGecko Demo / Pro Trial API Key:
# Google login at: https://www.coingecko.com/en/api
# Free quota: 30 calls/min (Demo) or 500 calls/min (7-day Pro trial).
COINGECKO_API_KEY=

# ------------------------------------------------------------------------------
# 9. Cluster 3: Macroeconomic & Government Releases Oracles
# ------------------------------------------------------------------------------
# Federal Reserve FRED API Key (St. Louis Fed):
# Obtain free instant 32-character key with Google sign-in at: https://fred.stlouisfed.org/docs/api/api_key.html
# Limits: 120 requests/minute.
FRED_API_KEY=

# U.S. Bureau of Labor Statistics (BLS) API v2 Registration Key:
# Obtain free key with email/Google sign-in at: https://data.bls.gov/registrationEngine/
# Limits: 500 queries/day, 50 series/query (Unregistered demo: 10 queries/day, 25 series/query).
BLS_API_KEY=

# Macro Oracle HTTP User-Agent header (Required by BLS/Fed federal scraping guidelines):
MACRO_ORACLE_USER_AGENT=PolymarketBot-MacroOracle/1.0 (+https://github.com/polymarketbot)
