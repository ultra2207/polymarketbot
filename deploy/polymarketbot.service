[Unit]
Description=Polymarket High-Frequency Market Making & Harvesting Daemon
Documentation=https://github.com/ultra2207/polymarketbot
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
User=polymarketbot
Group=polymarketbot
WorkingDirectory=/opt/polymarketbot

# Environment configuration: checks /etc/polymarketbot first, then local repo fallback
EnvironmentFile=-/etc/polymarketbot/polymarketbot.env
EnvironmentFile=-/opt/polymarketbot/.env

# Python and Low-RAM VPS Memory Optimization
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONOPTIMIZE=1
Environment=MALLOC_ARENA_MAX=2
Environment=DUCKDB_MEMORY_LIMIT=1GB
Environment=DUCKDB_THREADS=2

# Execution Command
# Default: 24/7 zero-capital paper soak of the single live pillar (RewardHarvester).
# Requires the canonical >=2 GB host profile from AGENTS.md; the 1 GB t3.micro was
# measured to restart under the full-universe walk.
ExecStart=/opt/polymarketbot/.venv/bin/python -m polymarketbot.paper.main --capital 3000 --duration 1800 --interval 10

# Alternate modes (override via systemctl edit polymarketbot):
#   Real Money Quoting (Blocked until Dec 1st - Requires --live, --yes, and populated credentials):
#     ExecStart=/opt/polymarketbot/.venv/bin/python -m polymarketbot.live.runner --live --yes --budget-pct 0.20

# Reliability & Crash Recovery
# on-failure (not always): a clean --duration exit must not re-enter trading, and
# a crash restart still runs reconcile_startup, which cancels/verifies venue orders.
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
KillMode=mixed
FinalKillSignal=SIGKILL

# Host memory guard. The measured soak peaks at 441-558 MB plus the agent harness;
# run this unit only on the >=2 GB host profile (AGENTS.md).
MemoryHigh=1.5G
MemoryMax=2.0G
MemorySwapMax=0
CPUQuota=95%

# Process and Security Hardening
LimitNOFILE=65535
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/polymarketbot/data /var/log/polymarketbot /var/lib/polymarketbot /tmp
PrivateTmp=true

# Logging to Systemd Journal with automatic log rotation
StandardOutput=journal
StandardError=journal
SyslogIdentifier=polymarketbot

[Install]
WantedBy=multi-user.target
