# ==============================================================================
# Polymarket Trading Bot - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Fill in your secrets and endpoints below.
# 3. NEVER commit your actual '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Polymarket CLOB L2/L3 API Credentials
# ------------------------------------------------------------------------------
# API credentials generated via the Polymarket CLOB or automated derivation.
# Required for live authenticated quoting and private WebSocket user streams.
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# ------------------------------------------------------------------------------
# 2. Polygon Wallet & Signing Credentials
# ------------------------------------------------------------------------------
# Private key for the Polygon EOA wallet authorized to sign CLOB orders or CTF ops.
# Format: 64-character hex string (with or without 0x prefix).
PRIVATE_KEY=

# Polymarket Proxy / Gnosis Safe wallet address on Polygon holding collateral.
# If using direct EOA trading, this can match the EOA address derived from PRIVATE_KEY.
PROXY_WALLET_ADDRESS=

# ------------------------------------------------------------------------------
# 3. Network RPC & API Endpoints
# ------------------------------------------------------------------------------
# Polygon PoS RPC endpoint for on-chain CTF split/merge transactions and gas queries.
POLYGON_RPC_URL=https://polygon-rpc.com

# Polymarket Central Limit Order Book (CLOB) REST API base URL.
CLOB_API_URL=https://clob.polymarket.com

# Polymarket CLOB WebSocket market data streaming endpoint.
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
