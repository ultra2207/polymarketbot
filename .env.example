# ==============================================================================
# Polymarket Trading Bot - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Fill in your secrets and endpoints below.
# 3. NEVER commit your actual '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Polymarket CLOB L2/L3 API Credentials
# ------------------------------------------------------------------------------
# API credentials generated via the Polymarket CLOB or automated derivation.
# Required for live authenticated quoting and private WebSocket user streams.
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# ------------------------------------------------------------------------------
# 2. Polygon Wallet & Signing Credentials
# ------------------------------------------------------------------------------
# Private key for the Polygon EOA wallet authorized to sign CLOB orders or CTF ops.
# Format: 64-character hex string (with or without 0x prefix).
PRIVATE_KEY=

# Polymarket Proxy / Gnosis Safe wallet address on Polygon holding collateral.
# If using direct EOA trading, this can match the EOA address derived from PRIVATE_KEY.
# This is the order `maker` (funder); `PRIVATE_KEY` is the `signer`.
PROXY_WALLET_ADDRESS=

# CLOB order signature mode:
#   0 = EOA (funds held by the key's own address)
#   1 = Polymarket proxy / email (Magic) wallet (set PROXY_WALLET_ADDRESS)
#   2 = Polymarket Gnosis Safe proxy (set PROXY_WALLET_ADDRESS)
#   3 = Deposit Wallet (POLY_1271; accounts created on/after 2026-05-04).
#       Set PROXY_WALLET_ADDRESS to the Deposit Wallet address; the private key is
#       the signer EOA that controls it. Orders are V2-only and are signed with the
#       Solady ERC-7739 wrapped signature the wallet validates via EIP-1271.
# Production CLOB order version is resolved from GET /version (currently 2).
POLY_SIGNATURE_TYPE=0

# ------------------------------------------------------------------------------
# 2b. Polymarket Relayer (gasless Deposit Wallet / Safe / Proxy operations)
# ------------------------------------------------------------------------------
# Create under polymarket.com -> Settings -> API Keys -> Relayer API Keys.
# RELAYER_API_KEY_ADDRESS is the Signer Address shown with the key. These are
# only used when a caller explicitly submits a relayer request; nothing in the
# bot submits automatically.
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=

# ------------------------------------------------------------------------------
# 3. Network RPC & API Endpoints
# ------------------------------------------------------------------------------
# Polygon PoS RPC endpoint for on-chain CTF split/merge transactions and gas queries.
# Resolution order: POLYGON_RPC_URL -> ETH_RPC_URL -> https://polygon.drpc.org.
# POLYGON_RPC_URL takes precedence when set; leave it empty (recommended) so the
# Alchemy key in ETH_RPC_URL below is used. Do NOT set
# https://polygon-rpc.com: it answers HTTP 401 "API key disabled".
POLYGON_RPC_URL=
# Alchemy app key, exactly as Alchemy issues it (an eth-mainnet URL). chain.rpc_url()
# rewrites the host to polygon-mainnet.g.alchemy.com with the same key, so this one
# key serves Polygon. A bare key (no scheme) is accepted too. The key is masked in logs.
ETH_RPC_URL=
# Optional comma-separated endpoints used only for reads (log indexing, balances).
# Settlement always broadcasts to the single resolved write endpoint from rpc_url().
POLYGON_RPC_URLS=

# Polymarket Central Limit Order Book (CLOB) REST API base URL.
CLOB_API_URL=https://clob.polymarket.com

# Polymarket CLOB WebSocket market data streaming endpoint.
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Optional NewsAPI.org wire for the data collector (free tier: 100 req/day).
# Leave empty to use GDELT + RSS + Gamma only.
NEWSAPI_KEY=

# ------------------------------------------------------------------------------
# 4. Kalshi (cross-venue prediction data)
# ------------------------------------------------------------------------------
# Key id shown with the API key (an API key id, not a secret on its own).
KALSHI_KEY_ID=
# Path to the PEM private key Kalshi issued. Keep it outside git
# (secrets/ is gitignored). Ed25519 and RSA-PSS keys are both supported.
KALSHI_PRIVATE_KEY_PATH=secrets/kalshi_private_key.pem
# demo or prod. A demo key authenticates only against demo-api.kalshi.co;
# production market data over REST needs no key, but the production
# WebSocket does (handshake returns HTTP 401 without a prod key).
KALSHI_ENV=demo
